#!/usr/bin/env python3
import sys as _sys
from pathlib import Path as _Path
_sys.path.insert(0, str(_Path(__file__).resolve().parents[1] / 'system'))  # engine lives in system/
import argparse
from collections import Counter
import json
from pathlib import Path

from engine.s1_load import csv_rows, json_rows, list_values
from engine.s4_decide import CLEAR, MATCH, REVIEW


VERDICTS = (CLEAR, MATCH, REVIEW)
COST = {
    CLEAR: {CLEAR: 0, MATCH: 3, REVIEW: 3},
    MATCH: {CLEAR: 60, MATCH: 0, REVIEW: 2},
    REVIEW: {CLEAR: 60, MATCH: 2, REVIEW: 0},
}


def key(row):
    return row['alert_id'], row['hit_id']


def unique(rows):
    indexed = {}
    for row in rows:
        if key(row) in indexed:
            raise ValueError('duplicate hit in scoring input')
        indexed[key(row)] = row
    return indexed


def ratio(numerator, denominator):
    return round(numerator / denominator, 5) if denominator else None


def score(predictions, labels):
    counts = Counter()
    reason_matches = customer_matches = evidence_coverage = 0
    for hit, label in labels.items():
        row = predictions[hit]
        expected, actual = label['decision'], row['decision']
        counts[expected, actual] += 1
        if expected != actual:
            continue
        reason_matches += row['reason_code'] in list_values(label, 'reason_codes')
        expected_ids = list_values(label, 'customer_record_ids')
        customer_matches += (row['customer_record_id'] in expected_ids
                             or (row['customer_record_id'] is None and not expected_ids))
        evidence_coverage += set(list_values(label, 'evidence')).issubset(row['evidence'])
    true_clear = counts[CLEAR, CLEAR]
    actual_clear = sum(counts[truth, CLEAR] for truth in VERDICTS)
    expected_clear = sum(counts[CLEAR, guess] for guess in VERDICTS)
    correct = sum(counts[label, label] for label in VERDICTS)
    cost = sum(count * COST[truth][guess] for (truth, guess), count in counts.items())
    baseline = sum(counts[truth, guess] * COST[truth][REVIEW]
                   for truth in VERDICTS for guess in VERDICTS)
    return {
        'labeled_hits': len(labels),
        'confusion_expected_then_predicted': {truth: {guess: counts[truth, guess] for guess in VERDICTS} for truth in VERDICTS},
        'unsafe_clearances': {'expected_match': counts[MATCH, CLEAR], 'expected_review': counts[REVIEW, CLEAR]},
        'correct_clearances': true_clear,
        'predicted_clearances': actual_clear,
        'expected_clearances': expected_clear,
        'clearance_precision': ratio(true_clear, actual_clear),
        'false_alarms_cleared_share': ratio(true_clear, expected_clear),
        'match_recall': ratio(counts[MATCH, MATCH], sum(counts[MATCH, guess] for guess in VERDICTS)),
        'review_rate_labeled': ratio(sum(counts[truth, REVIEW] for truth in VERDICTS), len(labels)),
        'review_rate_all_predictions': ratio(sum(row['decision'] == REVIEW for row in predictions.values()), len(predictions)),
        'decision_cost': cost,
        'review_all_cost': baseline,
        'decision_score_fraction': ratio(max(0, baseline - cost), baseline),
        'correct_decisions': correct,
        'accepted_reason_code_among_correct': reason_matches,
        'accepted_customer_id_among_correct': customer_matches,
        'reference_evidence_subset_among_correct': evidence_coverage,
    }


def main():
    parser = argparse.ArgumentParser(description='Report provisional local metrics using supplied practice labels.')
    parser.add_argument('predictions', type=Path)
    parser.add_argument('labels', type=Path)
    args = parser.parse_args()
    try:
        predictions = unique(json_rows(args.predictions))
        labels = unique((csv_rows if args.labels.suffix.lower() == '.csv' else json_rows)(args.labels))
        if not labels or not labels.keys() <= predictions.keys():
            raise ValueError('predictions must cover every supplied practice label')
        report = score(predictions, labels)
    except (OSError, ValueError, KeyError) as exc:
        parser.exit(1, f'Scoring failed. {exc}\n')
    print(json.dumps(report, indent=2))


if __name__ == '__main__':
    main()
